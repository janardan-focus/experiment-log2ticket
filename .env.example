# ---- Model ------------------------------------------------------------------
# Format is "<provider>:<model>". Swap providers by changing this one line and
# installing the matching extra (pip install -e ".[openai]" / ".[google]").
#   anthropic:claude-opus-5
#   openai:gpt-5.5
#   google_genai:gemini-3.6-flash
LLM_MODEL=anthropic:claude-opus-5

# Only the key matching LLM_MODEL's provider is needed.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=

# ---- GitHub -----------------------------------------------------------------
# PAT with issues read (and write, if you intend to use --live).
GITHUB_TOKEN=

# Where tickets go. Use a throwaway repo — never the real Log-2-Ticket repo.
GITHUB_REPO=repo

# Comma-separated. The agent can only ever write to a repo on this list.
REPO_ALLOWLIST=repo

# ---- Behaviour --------------------------------------------------------------
# Writing to GitHub is opt-in. Leave true unless you mean it.
DRY_RUN=true

# Ceiling on issues created/reopened in a single run.
MAX_WRITES_PER_RUN=5

# Below this, create a new issue rather than risk reopening the wrong one.
DUPLICATE_CONFIDENCE_FLOOR=0.7

# ---- Paths ------------------------------------------------------------------
# The codebase whose source the agent may read. Frame paths outside this root
# are rejected. Defaults to the bundled sample app.
TARGET_REPO_PATH=samples/app

# ---- Local variable capture -------------------------------------------------
# Live stack frames carry the variable values at the moment of failure, which
# is the strongest root-cause signal available — and the riskiest thing to
# send, since locals hold request bodies and whatever a credential was
# assigned to. Values are redacted, truncated and capped, but this stays off
# until you decide otherwise.
CAPTURE_LOCALS=false
MAX_LOCALS_PER_FRAME=12
MAX_LOCAL_REPR_CHARS=200
